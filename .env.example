# ==========================================
# 1. GOOGLE GEMINI AI (Usa la tua API Key da Google AI Studio)
# ==========================================
GEMINI_API_KEY="inserisci_qui_la_tua_gemini_api_key"
GEMINI_MODEL="gemini-2.5-flash"

# ==========================================
# 2. BOT TELEGRAM (Notifiche + Bottoni Approva/Scarta + Pannello Config)
# ==========================================
# Crea un bot con @BotFather su Telegram per ottenere il token
TELEGRAM_BOT_TOKEN="inserisci_token_bot_telegram"
# Ottieni il tuo ID scrivendo a @userinfobot su Telegram
TELEGRAM_CHAT_ID="inserisci_tuo_chat_id"

# ==========================================
# 3. NOTIFICHE EMAIL (Opzionale - SMTP Gmail)
# ==========================================
SMTP_ENABLED=false
SMTP_SERVER="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="tua_email@example.com"
SMTP_PASSWORD="tua_password_per_le_app_gmail"
NOTIFICATION_EMAIL="tua_email@example.com"

# ==========================================
# 4. CREDENZIALI PORTALI (Usate con sessioni persistenti e anti-ban)
# ==========================================
LINKEDIN_EMAIL="tua_email_linkedin@example.com"
LINKEDIN_PASSWORD=""

# ==========================================
# 5. SOGLIE DI FEDELTA E SCHEDULER
# ==========================================
# Oltre questa soglia (es. 85%), l'agente invia la candidatura in automatico
AUTO_APPLY_THRESHOLD=85
# Tra REVIEW_THRESHOLD (es. 65%) e AUTO_APPLY_THRESHOLD, invia un messaggio su Telegram con il bottone "Approva Invio"
REVIEW_THRESHOLD=65
# Intervallo di controllo in minuti (60 = ogni ora)
CHECK_INTERVAL_MINUTES=60
# Modalita headless per il browser (true su server, false in locale se vuoi vedere cosa fa)
HEADLESS_BROWSER=true
